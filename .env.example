# Copy this file to `.env` and fill in real values where needed.
# `.env` is gitignored so your real keys never get committed.
#
# Load it into your shell before running scripts:
#     set -a && source .env && set +a
#
# NONE of these are required to run the environment, tests, heuristic eval,
# or the Gradio demo. They are only used for optional workflows.

# ---------------------------------------------------------------------------
# 1. LLM agent eval (only if you run: python -m eval.run_eval --agent llm)
# ---------------------------------------------------------------------------
# Works with any OpenAI-compatible endpoint: OpenAI, Together, Groq, Fireworks,
# vLLM, Ollama (via its OpenAI shim), HF TGI, etc.
OPENAI_API_KEY=sk-REPLACE_ME_DUMMY_KEY_1234567890abcdef
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# 2. Hugging Face (only if you push the HF Space demo or model checkpoint)
# ---------------------------------------------------------------------------
# Create one at https://huggingface.co/settings/tokens (write scope).
HUGGINGFACE_HUB_TOKEN=hf_REPLACE_ME_DUMMY_TOKEN
HF_USERNAME=your-hf-username

# ---------------------------------------------------------------------------
# 3. Weights & Biases (only if you want live training curves during GRPO)
# ---------------------------------------------------------------------------
# Get from https://wandb.ai/authorize. If unset, training falls back to
# console logging and still works.
WANDB_API_KEY=REPLACE_ME_DUMMY_WANDB_KEY
WANDB_PROJECT=schemaquake
WANDB_ENTITY=your-wandb-username

# ---------------------------------------------------------------------------
# 4. Defaults for training notebook (optional overrides)
# ---------------------------------------------------------------------------
SCHEMAQUAKE_MODEL=unsloth/Qwen2.5-3B-Instruct-bnb-4bit
SCHEMAQUAKE_MAX_STEPS=20
SCHEMAQUAKE_P_NO_DRIFT=0.2
